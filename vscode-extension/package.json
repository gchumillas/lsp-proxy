{
  "name": "djs-vscode",
  "displayName": "DJS Language Support",
  "description": "Language support for .djs files via lsp-proxy",
  "version": "0.1.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:djs"],
  "contributes": {
    "languages": [
      {
        "id": "djs",
        "aliases": ["DJS", "djs"],
        "extensions": [".djs"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "djs",
        "scopeName": "source.js",
        "path": "./syntaxes/djs.tmGrammar.json"
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
